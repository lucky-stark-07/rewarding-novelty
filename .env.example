OPENROUTER_API_KEY=
# Optional. This scaffold uses a local JSON corpus, not Postgres.
POSTGRES_URL=
FRONTEND_ORIGIN=http://localhost:3000
FAST_MODEL=google/gemini-2.5-flash-lite
JUDGE_MODEL=google/gemini-2.5-flash
FALLBACK_MODEL=
HIGH_THRESHOLD=0.75
LOW_THRESHOLD=0.35
CORPUS_ACCEPTANCE_THRESHOLD=0.60
# Ambiguous claims are judged against this many nearest corpus claims; partial coverage earns this novelty.
ENTAILMENT_TOP_K=3
PARTIAL_NOVELTY_CREDIT=0.5
# Harness limits
LLM_MAX_CONCURRENCY=8
MAX_INFLIGHT_REQUESTS=32
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30
