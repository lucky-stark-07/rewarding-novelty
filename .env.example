OPENROUTER_API_KEY=
# Enables POST /corpus/regenerate (replaces the whole corpus, paid). Leave unset to keep it disabled.
# ADMIN_TOKEN=choose-a-long-random-string
# Optional. This scaffold uses a local JSON corpus, not Postgres.
POSTGRES_URL=
FRONTEND_ORIGIN=http://localhost:3000
FAST_MODEL=google/gemini-2.5-flash-lite
JUDGE_MODEL=google/gemini-2.5-flash
# Comma-separated OpenRouter fallbacks, sent as extra_body.models.
FAST_MODEL_FALLBACKS=
JUDGE_MODEL_FALLBACKS=
HIGH_THRESHOLD=0.75
LOW_THRESHOLD=0.35
CORPUS_ACCEPTANCE_THRESHOLD=0.60
# Ambiguous claims are judged against this many nearest corpus claims; partial coverage earns this novelty.
ENTAILMENT_TOP_K=3
PARTIAL_NOVELTY_CREDIT=0.5
# Harness limits
LLM_MAX_CONCURRENCY=8
LLM_MAX_ATTEMPTS=3
MAX_INFLIGHT_REQUESTS=32
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_SECONDS=30
# Uncomment to cap lifetime upstream spend per process; beyond it scoring degrades to embedding-only.
# LLM_BUDGET_USD=1.00
DEGRADED_RELEVANCE_THRESHOLD=0.10
CACHE_ENABLED=true
LLM_MEMORY_CACHE_SIZE=1024
EMBEDDING_CACHE_SIZE=4096
TRACE_LOG_PATH=logs/traces.jsonl
